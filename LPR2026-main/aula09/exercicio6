using System;
using System.Collections.Generic;
using System.Linq;

class Program {
    static void Main() {
        Dictionary<string, int> pessoas = new Dictionary<string, int>() {
            {"Ana", 25}, {"Bruno", 40}, {"Carlos", 18}, {"Daniela", 40}, {"Eduardo", 30}
        };

        // Média
        double media = pessoas.Values.Average();
        Console.WriteLine($"Média de idade: {media:F1}\n");

        Console.WriteLine("Pessoas com idade acima da média:");
        foreach (var p in pessoas.Where(p => p.Value > media)) {
            Console.WriteLine($"- {p.Key} ({p.Value} anos)");
        }

        // Mais velha e mais nova
        int maxIdade = pessoas.Values.Max();
        int minIdade = pessoas.Values.Min();

        Console.WriteLine($"\nMais velha(s): {string.Join(", ", pessoas.Where(p => p.Value == maxIdade).Select(p => p.Key))}");
        Console.WriteLine($"Mais nova(s): {string.Join(", ", pessoas.Where(p => p.Value == minIdade).Select(p => p.Key))}");

        // Remoção
        Console.Write("\nDigite uma idade Y para remover do dicionário: ");
        int y = int.Parse(Console.ReadLine());

        var chavesParaRemover = pessoas.Where(p => p.Value == y).Select(p => p.Key).ToList();
        foreach (var chave in chavesParaRemover) pessoas.Remove(chave);

        Console.WriteLine("\nDicionário Atualizado:");
        foreach (var p in pessoas) Console.WriteLine($"{p.Key}: {p.Value} anos");
    }
}