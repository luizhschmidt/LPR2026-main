#include <iostream>
#include <vector>
#include <numeric>
#include <algorithm>

int main() {
    std::vector<double> notas(5);
    std::cout << "Digite 5 notas:\n";
    for (int i = 0; i < 5; ++i) {
        std::cout << "Nota " << i + 1 << ": ";
        std::cin >> notas[i];
    }

    std::cout << "\nTodas as notas: ";
    for (double n : notas) std::cout << n << " ";

    double maior = *std::max_element(notas.begin(), notas.end());
    double menor = *std::min_element(notas.begin(), notas.end());
    double soma = std::accumulate(notas.begin(), notas.end(), 0.0);

    std::cout << "\nMaior nota: " << maior;
    std::cout << "\nMenor nota: " << menor;
    std::cout << "\nMédia das notas: " << soma / notas.size() << "\n";

    return 0;
}