#include <iostream>
#include <vector>
#include <string>
#include <set>

int main() {
    int total;
    std::cout << "Digite a quantidade de nomes: ";
    std::cin >> total;

    std::vector<std::string> nomes(total);
    for (int i = 0; i < total; ++i) {
        std::cin >> nomes[i];
    }

    std::cout << "\nSaida:\n";
    while (!nomes.empty()) {
        std::vector<std::string> linha;
        std::set<size_t> tamanhos_usados;
        std::vector<std::string> restantes;

        for (const auto& nome : nomes) {
            if (tamanhos_usados.find(nome.length()) == tamanhos_usados.end()) {
                linha.push_back(nome);
                tamanhos_usados.insert(nome.length());
            } else {
                restantes.push_back(nome);
            }
        }

        // Imprime a linha
        for (size_t i = 0; i < linha.size(); ++i) {
            std::cout << linha[i] << (i + 1 < linha.size() ? ", " : "");
        }
        std::cout << "\n";

        nomes = restantes; 
    }

    return 0;
}